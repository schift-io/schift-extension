{
  "name": "@schift-io/extension",
  "version": "0.1.10",
  "description": "Schift Extension for Codex and Claude: runtime wiring, lifecycle hooks, and local APM authoring.",
  "private": false,
  "type": "module",
  "bin": {
    "extension": "bin/schift-extension.mjs"
  },
  "scripts": {
    "test": "PYTHONPATH=src python3 -m unittest discover -s tests -v",
    "smoke": "bash scripts/smoke.sh",
    "venv:verify": "bash scripts/verify-venv.sh"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.11"
  },
  "files": [
    "bin",
    "src/apm_bridge/__init__.py",
    "src/apm_bridge/cli.py",
    "src/apm_bridge/core.py",
    "src/apm_bridge/studio.py",
    "src/mcp-upload.mjs",
    "src/web",
    "scripts",
    "README.md",
    "DESIGN.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0"
  },
  "license": "Apache-2.0"
}
